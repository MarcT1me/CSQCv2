<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <OutputPath>bin\$(Configuration)</OutputPath>

        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <PublishSingleFile>false</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

        <Configurations>Debug;Release</Configurations>
        <Platforms>x64</Platforms>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

        <ApplicationIcon>app.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <Company>QuantumDev</Company>
        <Version>0.2.1</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <FileVersion>0.2.0.0</FileVersion>
        <NeutralLanguage>ru-RU</NeutralLanguage>
        <VersionFile>app</VersionFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Launcher\Launcher.csproj"/>
        <ProjectReference Include="..\AppLib\AppLib.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="app.ico">
            <LogicalName>TestApp:app.ico</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <Target Name="CopyRuntimes" AfterTargets="Build">
        <MakeDir Directories="$(OutputPath)\bin\runtimes"/>

        <ItemGroup>
            <RuntimeBinaries Include="$(OutputPath)\**\freetype6.dll"/>
            <RuntimeBinaries Include="$(OutputPath)\**\Ijwhost.dll"/>
            <RuntimeBinaries Include="$(OutputPath)\**\openxr_loader.dll"/>
        </ItemGroup>

        <Move SourceFiles="@(RuntimeBinaries)" DestinationFolder="$(OutputPath)\bin\runtimes"/>
        <RemoveDir Directories="$(OutputPath)\runtimes"/>
    </Target>

    <Target Name="MoveAppBinaries" AfterTargets="CopyRuntimes">
        <ItemGroup>
            <TempAppBinaries Include="$(OutputPath)\*.dll"/>
        </ItemGroup>

        <ItemGroup>
            <UniqueTempAppBinaries Include="@(TempAppBinaries-&gt;Distinct())"/>
        </ItemGroup>

        <Move SourceFiles="@(UniqueTempAppBinaries)" DestinationFolder="$(OutputPath)\bin"/>

        <Move SourceFiles="$(OutputPath)\bin\Launcher.dll" DestinationFolder="$(OutputPath)"/>
        <Move SourceFiles="$(OutputPath)\bin\TestApp.dll" DestinationFolder="$(OutputPath)" Condition="Exists('$(OutputPath)\bin\TestApp.dll')"/>
    </Target>

    <Target Name="MoveEngineBinaries" AfterTargets="MoveAppBinaries">
        <MakeDir Directories="$(OutputPath)\bin\Engine"/>

        <ItemGroup>
            <TempEngineBinaries Include="$(OutputPath)\**\QuantumEngine.dll"/>
            <TempEngineBinaries Include="$(OutputPath)\**\QuantumEngine.Core.dll"/>
            <TempEngineBinaries Include="$(OutputPath)\**\QuantumEngine.Headless.dll"/>
            <TempEngineBinaries Include="$(OutputPath)\**\MirageAPI.dll"/>
        </ItemGroup>

        <ItemGroup>
            <UniqueTempEngineBinaries Include="@(TempEngineBinaries-&gt;Distinct())"/>
        </ItemGroup>

        <Move SourceFiles="@(UniqueTempEngineBinaries)" DestinationFolder="$(OutputPath)\bin\Engine"/>
    </Target>

    <Target Name="DelTrash" AfterTargets="MoveEngineBinaries">
        <ItemGroup>
            <TrashFiles Include="$(OutputPath)\**\*.pdb"/>
        </ItemGroup>

        <Delete Files="@(TrashFiles)"/>
    </Target>

    <Target Name="PrepareForPublish" AfterTargets="Publish">

        <ItemGroup>
            <PublishFiles Include="$(OutputPath)\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(PublishFiles)"
              DestinationFiles="@(PublishFiles->'$(PublishDir)\%(RecursiveDir)%(Filename)%(Extension)')"/>
    </Target>

    <!-- Import common version management -->
    <Import Project="..\Version.targets"/>
</Project>
