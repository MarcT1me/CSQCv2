<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
    
    <UsingTask TaskName="QuantumAssetProcessor"
               AssemblyFile="$(MSBuildThisFileDirectory)../lib/win-x64/Quantum.Sdk.Tasks.dll"/>

    <!-- Валидация конфига -->
    <Target Name="ValidateQuantumConfig" BeforeTargets="BeforeBuild">
        <Error Text="Quantum.gameconfig not found. Please create configuration file."
               Condition="!Exists('$(QuantumGameConfig)')"/>
    </Target>

    <!-- Основная задача обработки ассетов -->
    <Target Name="ProcessQuantumAssets" BeforeTargets="ValidateQuantumConfig">
        <QuantumAssetProcessor
                ProjectDir="$(MSBuildProjectDirectory)"
                OutputPath="$(OutputPath)"
                ConfigFile="$(QuantumGameConfig)"
                Configuration="$(Configuration)">
            <Output TaskParameter="ProcessedAssets" ItemName="Content"/>
        </QuantumAssetProcessor>
    </Target>

    <!-- Копирование нативных библиотек ПОСЛЕ обработки ассетов -->
    <Target Name="CopyNativeLibraries" AfterTargets="ProcessQuantumAssets">
        <ItemGroup>
            <NativeLibs Include="$(NuGetPackageRoot)\quantumengine.nativelibs\**\runtimes\**\*"/>
        </ItemGroup>

        <Copy SourceFiles="@(NativeLibs)"
              DestinationFiles="@(NativeLibs->'$(OutputPath)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"/>
    </Target>

</Project>